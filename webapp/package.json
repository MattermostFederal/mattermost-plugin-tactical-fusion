{
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "build:watch": "webpack --mode=production --watch",
    "debug": "webpack --mode=none",
    "debug:watch": "webpack --mode=development --watch",
    "lint": "eslint --quiet --cache .",
    "fix": "eslint --quiet --fix --cache .",
    "check-types": "tsc",
    "postinstall": "playwright install chromium",
    "test": "playwright test --config=playwright.config.ts && playwright test --config=playwright-ct.config.ts",
    "test:pw": "playwright test --config=playwright.config.ts",
    "test:pw-ct": "playwright test --config=playwright-ct.config.ts",
    "test:coverage": "c8 --config=c8-unit.json --temp-directory=.v8-unit-coverage --reporter=text --reporter=html --reports-dir=coverage playwright test --config=playwright.config.ts",
    "test:pw-ct-coverage": "rm -rf .v8-ct-coverage && playwright test --config=playwright-ct.config.ts && c8 report --temp-directory=.v8-ct-coverage --reports-dir=coverage-ct --reporter=text --reporter=html --exclude='**/node_modules/**'",
    "test:coverage-merged": "rm -rf .v8-merged-coverage && mkdir -p .v8-merged-coverage && cp .v8-unit-coverage/*.json .v8-merged-coverage/ 2>/dev/null; cp .v8-ct-coverage/*.json .v8-merged-coverage/ 2>/dev/null; c8 report --config=c8-merged.json --temp-directory=.v8-merged-coverage --reports-dir=coverage-merged --reporter=text --reporter=html"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@mattermost/types": "11.9.0",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-redux": "7.1.34",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "ajv": "8.20.0",
    "babel-loader": "10.1.1",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "c8": "12.0.0",
    "css-loader": "7.1.4",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "react-dom": "19.2.8",
    "sass": "1.103.1",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "typescript": "6.0.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "dependencies": {
    "core-js": "3.50.0",
    "maplibre-gl": "6.5.0",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-redux": "9.3.0",
    "redux": "5.0.1"
  }
}
