{
    "all": true,
    "excludeAfterRemap": true,
    "include": ["src/**/*.{ts,tsx}"],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.pw.tsx",
        "src/**/*Harness.tsx",
        "src/**/*_fixtures.ts",
        "src/**/stub_*.ts",
        "src/decorators/types.ts",
        "src/decorators/airport/types.ts",
        "src/types/**",
        "src/manifest.ts"
    ],
    "reporter": ["text", "html"]
}
